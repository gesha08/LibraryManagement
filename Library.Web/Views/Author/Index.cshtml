@model IEnumerable<Library.Web.ViewModels.Author.AuthorIndexViewModel>

@{
    ViewData["Title"] = "Authors";
}

<h1>Authors</h1>

<div class="row mb-3">
    <div class="col-md-3">
        <input type="text" id="authorSearch" class="form-control" placeholder="Search by name..." value="@ViewBag.Search" />
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <button type="button" id="authorFilterBtn" class="btn btn-primary w-100">Filter</button>
    </div>
</div>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Author</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Birth Date</th>
            <th>Books Count</th>
            <th></th>
        </tr>
    </thead>
    <tbody id="authorRows">
        @await Html.PartialAsync("_AuthorRows", Model)
    </tbody>
</table>

@section Scripts {
    <script>
        function loadAuthorRows() {
            const search = document.getElementById('authorSearch').value;
            fetch(`/Author/Search?search=${encodeURIComponent(search)}`)
                .then(response => response.text())
                .then(html => {
                    document.getElementById('authorRows').innerHTML = html;
                })
                .catch(error => console.error('Error loading authors:', error));
        }

        document.getElementById('authorFilterBtn').addEventListener('click', loadAuthorRows);

        document.getElementById('authorSearch').addEventListener('keypress', function (e) {
            if (e.key === 'Enter') loadAuthorRows();
        });
    </script>
}
