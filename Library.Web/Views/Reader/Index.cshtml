@model IEnumerable<Library.Web.ViewModels.Reader.ReaderIndexViewModel>

@{
    ViewData["Title"] = "Readers";
}

<h1>Readers</h1>

<div class="row mb-3">
    <div class="col-md-3">
        <input type="text" id="readerSearch" class="form-control" placeholder="Search by name or email..." value="@ViewBag.Search" />
    </div>
    <div class="col-md-2 d-flex align-items-end">
        <button type="button" id="readerFilterBtn" class="btn btn-primary w-100">Filter</button>
    </div>
</div>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Reader</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Email</th>
            <th>Registration Date</th>
            <th>Books Borrowed</th>
            <th></th>
        </tr>
    </thead>
    <tbody id="readerRows">
        @await Html.PartialAsync("_ReaderRows", Model)
    </tbody>
</table>

@section Scripts {
    <script>
        function loadReaderRows() {
            const search = document.getElementById('readerSearch').value;
            fetch(`/Reader/Search?search=${encodeURIComponent(search)}`)
                .then(response => response.text())
                .then(html => {
                    document.getElementById('readerRows').innerHTML = html;
                })
                .catch(error => console.error('Error loading readers:', error));
        }

        document.getElementById('readerFilterBtn').addEventListener('click', loadReaderRows);

        document.getElementById('readerSearch').addEventListener('keypress', function (e) {
            if (e.key === 'Enter') loadReaderRows();
        });
    </script>
}
